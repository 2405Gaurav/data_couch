# =============================================================================
# .gitignore — AI-Powered Code Vulnerability Analyzer
# =============================================================================

# -----------------------------------------------------------------------------
# SECRETS & ENVIRONMENT VARIABLES
# Never commit API keys, signing keys, or any credentials.
# -----------------------------------------------------------------------------
.env
.env.local
.env.development
.env.production
.env.staging
.env.test
*.env

# -----------------------------------------------------------------------------
# NODE.JS DEPENDENCIES
# The node_modules folder is large and fully reproducible via `npm install`.
# -----------------------------------------------------------------------------
node_modules/
.npm/
.yarn/
.pnp.*

# -----------------------------------------------------------------------------
# PACKAGE MANAGER LOCKS
# Keep package-lock.json (npm) but ignore alternatives if not using them.
# Uncomment the one you're NOT using.
# -----------------------------------------------------------------------------
# yarn.lock
# pnpm-lock.yaml

# -----------------------------------------------------------------------------
# BUILD & COMPILED OUTPUT
# Compiled/transpiled files should not be tracked.
# -----------------------------------------------------------------------------
dist/
build/
out/
.output/

# -----------------------------------------------------------------------------
# LOGS
# Log files generated at runtime should not be in version control.
# -----------------------------------------------------------------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pids/
*.pid
*.seed
*.pid.lock

# -----------------------------------------------------------------------------
# RUNTIME DATA & RESULTS
# Any files written at runtime (e.g., analysis results saved to disk).
# -----------------------------------------------------------------------------
results/
tmp/
temp/
*.tmp
*.temp

# -----------------------------------------------------------------------------
# COVERAGE & TEST OUTPUT
# Test coverage reports generated by tools like Jest or c8.
# -----------------------------------------------------------------------------
coverage/
.nyc_output/
*.lcov

# -----------------------------------------------------------------------------
# OS-GENERATED FILES
# Files created automatically by macOS, Windows, or Linux file managers.
# -----------------------------------------------------------------------------

# macOS
.DS_Store
.AppleDouble
.LSOverride
Icon?
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Linux
*~

# -----------------------------------------------------------------------------
# EDITORS & IDEs
# Project-specific IDE settings that shouldn't be shared.
# -----------------------------------------------------------------------------

# VS Code (share .vscode/extensions.json but not personal settings)
.vscode/*
!.vscode/extensions.json
!.vscode/launch.json

# JetBrains (WebStorm, IntelliJ)
.idea/
*.iml
*.iws

# Vim / Neovim
*.swp
*.swo
Session.vim

# Sublime Text
*.sublime-workspace

# Emacs
*#
.#*

# -----------------------------------------------------------------------------
# INNGEST
# Local Inngest Dev Server state and cache files.
# -----------------------------------------------------------------------------
.inngest/

# -----------------------------------------------------------------------------
# MISCELLANEOUS
# -----------------------------------------------------------------------------

# Optional REPL history
.node_repl_history

# ESLint cache
.eslintcache

# Prettier cache
.prettiercache

# TypeScript build info (if TypeScript is added later)
*.tsbuildinfo