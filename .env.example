# =============================================================================
# AI-Powered Code Vulnerability Analyzer - Environment Configuration
# =============================================================================
#
# Copy this file to .env and fill in your actual values:
#   cp .env.example .env
#
# NEVER commit your .env file to version control.
# These values are secrets that must remain private.
# =============================================================================

# ---------------------------------------------------------------------------
# PORT - The port where the Express server listens for HTTP requests.
#
# Default: 3000
# ---------------------------------------------------------------------------
PORT=3000

# ---------------------------------------------------------------------------
# GEMINI_API_KEY - Your Google AI Studio API key for accessing the Gemini model.
#
# How to get one:
#   1. Go to https://aistudio.google.com/apikey
#   2. Create a new API key
#   3. Paste the key here
#
# This is REQUIRED. The application will crash on startup without it.
# The Gemini API is used to perform AI-powered security analysis on code.
# ---------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here

# ---------------------------------------------------------------------------
# INNGEST_EVENT_KEY - The event key used to authenticate with Inngest.
#
# When running the Inngest Dev Server locally, this can be left as
# "test" or any placeholder value. The dev server does not enforce
# authentication.
#
# For production, obtain this from your Inngest dashboard:
#   https://app.inngest.com
#
# This key proves that events sent to Inngest come from your application.
# ---------------------------------------------------------------------------
INNGEST_EVENT_KEY=test

# ---------------------------------------------------------------------------
# INNGEST_SIGNING_KEY - The signing key used to verify webhook signatures
# from Inngest back to your application.
#
# When running the Inngest Dev Server locally, this can be left as
# "test" or any placeholder value.
#
# For production, obtain this from your Inngest dashboard.
#
# This key ensures that incoming workflow triggers are genuinely from Inngest
# and not from a malicious source (prevents spoofing attacks).
# ---------------------------------------------------------------------------
INNGEST_SIGNING_KEY=test
